(ns pii.redactor.main
  (:require phel.cli :as cli)
  (:require phel.string :as s)
  (:require pii.redactor.core :as core)
  (:require pii.redactor.db :as db)
  (:require pii.redactor.policies :as policies))

;; ---------------------------------------------------------------------------
;; Logging
;; ---------------------------------------------------------------------------

(defn log! [level message & args]
  (let [rendered (if (empty? args) message (apply format message args))]
    (php/fwrite php/STDERR
                (str (php/date "H:i:s") " [" level "] " rendered "\n"))))

(defn info! [message & args]
  (apply log! "INFO" message args))

(defn error! [message & args]
  (apply log! "ERROR" message args))

;; ---------------------------------------------------------------------------
;; CLI data
;; ---------------------------------------------------------------------------

(defn- whitelist [raw]
  (if (s/blank? raw)
    []
    (->> (s/split raw #",")
         (map s/trim)
         (remove s/blank?)
         vec)))

(defn execution-mode
  "Resolve CLI write intent. No flag means :plan; only --apply means :apply."
  [apply? explicit-preview?]
  (when (and apply? explicit-preview?)
    (throw
     (new InvalidArgumentException
          "Choose either --apply or --dry-run, not both")))
  (if apply? :apply :plan))

(defn options-from [ctx]
  (let [mode (execution-mode
              (boolean (cli/opt ctx "apply"))
              (boolean (cli/opt ctx "dry-run")))]
    {:config (cli/opt ctx "config")
     ;; Planning is the safe default. Only --apply crosses the write boundary.
     :dry-run (= :plan mode)
     :show-values (boolean (cli/opt ctx "show-values"))
     :verbose (boolean (cli/opt ctx "verbose"))
     :redact-names (not (boolean (cli/opt ctx "no-names")))
     :redact-urls (not (boolean (cli/opt ctx "no-urls")))
     :redact-ips (not (boolean (cli/opt ctx "no-ips")))
     :redact-options (boolean (cli/opt ctx "redact-options"))
     :table (cli/opt ctx "table")
     :summary (boolean (cli/opt ctx "summary"))
     :whitelist-users (whitelist (cli/opt ctx "whitelist-users"))}))

(defn- absolute-path [path]
  (if (s/starts-with? path "/")
    path
    (str (php/getcwd) "/" path)))

;; ---------------------------------------------------------------------------
;; Discovery phase
;; ---------------------------------------------------------------------------

(defn- group-label [group]
  (str (name (:type group)) "=['" (s/join "', '" (:columns group)) "']"))

(defn log-discovery! [options discovery]
  (info! "Discovered PII tables:")
  (doseq [table-spec :in (:tables discovery)
          :when (core/selected-table? options (:table table-spec))]
    (info! "  %-40s %s"
           (:table table-spec)
           (s/join " | " (map group-label (:groups table-spec)))))
  (let [postmeta (:postmeta-keys discovery)
        usermeta (:usermeta-keys discovery)]
    (when-not (empty? postmeta)
      (info! "Personal postmeta keys (%d): %s"
             (count postmeta)
             (str (s/join ", " (take 15 postmeta))
                  (if (> (count postmeta) 15) "..." ""))))
    (when-not (empty? usermeta)
      (info! "Personal usermeta keys (%d): %s"
             (count usermeta)
             (str (s/join ", " (take 15 usermeta))
                  (if (> (count usermeta) 15) "..." ""))))))

(defn log-meta-counts! [pdo options discovery]
  (when (:verbose options)
    (doseq [meta-key :in (:usermeta-keys discovery)]
      (info! "  wp_usermeta[%s] has %d non-empty values"
             meta-key (db/meta-count pdo "wp_usermeta" meta-key)))
    (doseq [meta-key :in (:postmeta-keys discovery)]
      (info! "  wp_postmeta[%s] has %d non-empty values"
             meta-key (db/meta-count pdo "wp_postmeta" meta-key)))))

(defn- comment-authors [pdo users]
  (core/comment-authors-to-redact
   (map :login users)
   (db/load-display-names pdo)
   (db/load-approved-comment-authors pdo)))

;; ---------------------------------------------------------------------------
;; Plan phase: interpreted from policies/table-policies (see policies.phel)
;; ---------------------------------------------------------------------------

(defn- build-and-report-plan [ctx]
  (let [{:keys [plan messages]} (policies/build-plan ctx)]
    (doseq [message :in messages]
      (apply info! (first message) (rest message)))
    plan))

;; ---------------------------------------------------------------------------
;; Execute/preview phase
;; ---------------------------------------------------------------------------

(defn- log-planned-summary! [plan]
  (info! "=== Planned operations by table ===")
  (let [by-table (core/changes-by-table plan)]
    (if (empty? by-table)
      (info! "  No operations planned.")
      (doseq [table :in (sort (keys by-table))]
        (info! "  %-40s %d operation(s)" table (get by-table table))))))

(defn- log-affected-summary! [by-table]
  (info! "=== Affected rows by table ===")
  (if (empty? by-table)
    (info! "  No rows changed; the database already satisfies the redaction plan.")
    (doseq [table :in (sort (keys by-table))]
      (info! "  %-40s %d row(s)" table (get by-table table)))))

(defn query-preview
  "Render a planned statement without exposing parameter values by default."
  [pdo options query]
  (if (:show-values options)
    (core/render-query pdo query)
    (format "%s  [parameters hidden: %d]"
            (:sql query)
            (count (:params query)))))

(defn finish-plan!
  "Preview or execute a plan and return execution statistics. Planned
   operations describe policy intent; affected rows describe actual writes."
  [pdo options plan]
  (let [queries    (:queries plan)
        statements (count queries)
        operations (count (:changes plan))]
    (if (:dry-run options)
      (do
        (info! "Would execute %d SQL statement(s)" statements)
        (doseq [query :in (take 25 queries)]
          (info! "  %s" (query-preview pdo options query)))
        (when (> statements 25)
          (info! "  ... and %d more" (- statements 25)))
        (log-planned-summary! plan)
        {:mode :plan :statements statements :operations operations})
      (if (empty? queries)
        (do
          (info! "Nothing to do.")
          {:mode :apply :statements 0 :operations operations
           :affected 0 :by-table {}})
        (do
          (info! "Executing %d SQL statement(s) inside a transaction..."
                 statements)
          (let [report (db/execute-queries-report! pdo queries)]
            (info! "Transaction complete. Total affected rows: %d"
                   (:affected report))
            (log-affected-summary! (:by-table report))
            (merge {:mode :apply :statements statements
                    :operations operations}
                   report)))))))

(defn log-locations! [tables]
  (doseq [table-spec :in tables
          group :in (:groups table-spec)
          column :in (:columns group)]
    (info! "%-40s %-10s %s"
           (:table table-spec)
           (name (:type group))
           column)))

(defn run-redactor [options]
  (let [config-path (absolute-path (:config options))
        config      (db/parse-wp-config config-path)]
    (info! "DB credentials: host=%s  name=%s  user=%s"
           (:host config) (:name config) (:user config))
    (when (:dry-run options)
      (info! "=== PLAN MODE (no changes will be written) ==="))
    (let [pdo       (db/connect config)
          discovery {:tables (db/discover-pii-tables pdo (:name config))
                     :usermeta-keys (db/discover-usermeta-keys pdo)
                     :postmeta-keys (db/discover-postmeta-keys pdo)}]
      (if (:summary options)
        (do (log-locations! (:tables discovery)) 0)
        (do
          (log-discovery! options discovery)
          (let [users   (db/load-users pdo)
                authors (comment-authors pdo users)]
            (when (:verbose options)
              (info! "Loaded %d user_logins for whitelist check" (count users))
              (when-not (empty? authors)
                (if (:show-values options)
                  (info! "Comment authors to redact (%d): %s"
                         (count authors) (s/join ", " authors))
                  (info! "Comment authors to redact: %d value(s) hidden"
                         (count authors)))))
            (let [ctx          {:pdo pdo
                                :options options
                                :discovery discovery
                                :users users
                                :authors authors
                                :log info!}
                  replacements (policies/scan-replacements ctx)]
              (log-meta-counts! pdo options discovery)
              (let [public-email-count (db/published-email-count pdo)]
                (when (pos? public-email-count)
                  (info! (str "wp_posts.post_content: %d published posts contain email patterns "
                              "(skipped — public content)")
                         public-email-count)))
              (info! "Replacement map: %s" (core/replacement-stats replacements))
              (let [plan      (build-and-report-plan
                               (assoc ctx :replacements replacements))
                    execution (finish-plan! pdo options plan)]
                (when-not (empty? (:whitelist-users options))
                  (if (:show-values options)
                    (info! "Whitelisted users (skipped): %s"
                           (s/join ", " (sort (:whitelist-users options))))
                    (info! "Whitelisted users skipped: %d value(s) hidden"
                           (count (:whitelist-users options)))))
                (if (:dry-run options)
                  (info! "Plan complete. Planned operations: %d"
                         (:operations execution))
                  (info! "Redaction complete. Affected rows: %d"
                         (:affected execution)))
                0))))))))

(defn- run-command [ctx]
  (try
    (run-redactor (options-from ctx))
    (catch Throwable exception
      (error! "%s" (.getMessage exception))
      1)))

(def app
  (cli/application
   {:name "pii-redactor"
    :version "1.0.0"
    :default "redact"
    :commands
    [{:name "redact"
      :doc "Anonymize non-public PII in a WordPress database"
      :help (str "Discovers PII columns and creates a deterministic redaction "
                 "plan. Planning is the default; pass --apply explicitly to write.")
      :opts [{:name "config"
              :mode :required
              :default "wp-config.php"
              :doc "Path to wp-config.php"}
             {:name "apply"
              :mode :none
              :doc "Execute the plan; without this option nothing is written"}
             {:name "dry-run"
              :mode :none
              :doc "Explicitly select the default no-write plan mode"}
             {:name "show-values"
              :mode :none
              :doc "Unsafe: include raw SQL parameter values in plan output"}
             {:name "no-names"
              :mode :none
              :doc "Skip name fields"}
             {:name "no-urls"
              :mode :none
              :doc "Skip URL fields"}
             {:name "no-ips"
              :mode :none
              :doc "Skip IP addresses"}
             {:name "redact-options"
              :mode :none
              :doc "Delete supported disposable wp_options cache rows"}
             {:name "table"
              :mode :required
              :doc "Restrict generic discovery to one table"}
             {:name "summary"
              :mode :none
              :doc "Print PII locations without redacting"}
             {:name "whitelist-users"
              :mode :required
              :doc "Comma-separated user_login values to preserve"}]
      :run run-command}]}))
