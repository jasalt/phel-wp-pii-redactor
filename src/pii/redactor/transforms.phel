(ns pii.redactor.transforms
  (:require phel.string :as s))

;; Pure value-level primitives for the replacement engine. Keep this namespace
;; free of PDO, CLI, and mutable registry state so every function can be used
;; directly from a REPL.

(def supported-kinds
  #{:email :url :ip :login :name :phone :address :credential :text})

(defn valid-email? [value]
  (and
   (string? value)
   (some? (re-find #"^[^@\s]+@[^@\s]+\.[^@\s]+$" value))))

(defn valid-url? [value]
  (when (string? value)
    (let [parts (php->phel (php/parse_url value))]
      (and
       (not (false? parts))
       (contains? #{"http" "https"} (get parts "scheme"))
       (not (empty? (or (get parts "host") "")))))))

(defn valid-ip? [value]
  (and
   (string? value)
   (not (false? (php/filter_var value php/\FILTER_VALIDATE_IP)))))

(defn canonicalize
  "Return the stable comparison/token form for a supported PII kind.

   This function does not decide whether the value is valid or should be
   changed. It is intentionally public for REPL inspection and focused tests."
  [kind value]
  (when-not (contains? supported-kinds kind)
    (throw
     (php/new \InvalidArgumentException
              (str "Unsupported PII kind: " kind))))
  (let [trimmed (s/trim (or value ""))]
    (case kind
      :email (s/lower-case trimmed)
      :login (s/lower-case trimmed)
      :name  (s/lower-case trimmed)
      :ip    (let [packed (php/inet_pton trimmed)]
               (if (false? packed) trimmed (php/inet_ntop packed)))
      trimmed)))

(defn valid-value?
  "Return whether `value` is a non-empty value accepted for `kind`."
  [kind value]
  (let [canonical (canonicalize kind value)]
    (case kind
      :email (valid-email? canonical)
      :url   (boolean (valid-url? canonical))
      :ip    (valid-ip? canonical)
      (not (s/blank? canonical)))))

(defn hmac-token
  "Return a namespaced hexadecimal HMAC prefix.

   The namespace prevents equal text in different PII kinds from sharing a
   token. `secret` must be supplied by the caller and is never stored here."
  [secret token-namespace seed length]
  (when (s/blank? secret)
    (throw
     (php/new \InvalidArgumentException
              "A non-empty redaction secret is required")))
  (when-not (<= 1 length 64)
    (throw
     (php/new \InvalidArgumentException
              "HMAC token length must be between 1 and 64")))
  (let [namespace-name (if (keyword? token-namespace)
                         (name token-namespace)
                         (str token-namespace))
        digest         (php/hash_hmac
                        "sha256"
                        (str namespace-name "\u0000" seed)
                        secret)]
    (s/subs digest 0 length)))

(defn redacted-value?
  "Recognize values emitted by this namespace.

   Reserved domains and address ranges make this check independent of in-memory
   history, which is required for idempotent repeated runs."
  [kind value]
  (let [canonical (canonicalize kind value)]
    (case kind
      :email (some?
              (re-find
               #"^anon-[0-9a-f]{20}@redacted\.example\.invalid$"
               canonical))
      :url   (some?
              (re-find
               #"^https://redacted\.example\.invalid/[0-9a-f]{20}$"
               canonical))
      :login (some? (re-find #"^anon-[0-9a-f]{16}$" canonical))
      :ip    (or
              (some?
               (re-find
                #"^192\.0\.2\.(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-4])$"
                canonical))
              (s/starts-with? canonical "2001:db8:"))
      false)))

(defn- token-context [kind canonical context]
  {:namespace (get context :namespace kind)
   :seed (if (contains? context :seed)
           (get context :seed)
           canonical)})

(defn token-replacement
  "Render a valid, kind-specific pseudonym.

   Supported token kinds are email, URL, login, and IP. Other kinds should use
   an explicit strategy such as `:clear` or a `:constant` strategy."
  [secret kind canonical & [context]]
  (let [{:keys [namespace seed]}
        (token-context kind canonical (or context {}))]
    (case kind
      :email
      (str "anon-" (hmac-token secret namespace seed 20)
           "@redacted.example.invalid")

      :url
      (str "https://redacted.example.invalid/"
           (hmac-token secret namespace seed 20))

      :login
      (str "anon-" (hmac-token secret namespace seed 16))

      :ip
      (if (s/contains? canonical ":")
        (let [token (hmac-token secret namespace seed 24)]
          (format "2001:db8:%s:%s:%s:%s:%s:%s"
                  (s/subs token 0 4)
                  (s/subs token 4 8)
                  (s/subs token 8 12)
                  (s/subs token 12 16)
                  (s/subs token 16 20)
                  (s/subs token 20 24)))
        (let [token (hmac-token secret namespace seed 8)
              host  (inc (mod (int (php/hexdec token)) 254))]
          (str "192.0.2." host)))

      (throw
       (php/new \InvalidArgumentException
                (str "Token strategy is not supported for kind " kind))))))

(defn- strategy-op [strategy]
  (cond
    (keyword? strategy) strategy
    (vector? strategy)  (first strategy)
    (map? strategy)     (:op strategy)
    nil))

(defn- constant-value [strategy]
  (if (map? strategy)
    (:value strategy)
    (second strategy)))

(defn replacement
  "Calculate a replacement for a valid canonical value and strategy."
  [secret kind strategy canonical & [context]]
  (case (strategy-op strategy)
    :token    (token-replacement secret kind canonical (or context {}))
    :clear    ""
    :constant (constant-value strategy)
    (throw
     (php/new \InvalidArgumentException
              (str "Unsupported redaction strategy: " strategy)))))

(defn redact
  "Apply one value strategy and return an inspectable result map.

   `(redact secret :email :token value)` is deterministic and idempotent.
   Pass `{:seed entity-id :namespace :user}` as the optional fifth argument to
   correlate output with an entity rather than the original field value."
  [secret kind strategy value & [context]]
  (let [canonical (canonicalize kind value)]
    (cond
      (s/blank? canonical)
      {:status :skipped
       :reason :empty
       :kind kind
       :before value
       :after value}

      (not (valid-value? kind canonical))
      {:status :skipped
       :reason :invalid
       :kind kind
       :before value
       :after value}

      (redacted-value? kind canonical)
      {:status :unchanged
       :reason :already-redacted
       :kind kind
       :before value
       :after value}

      :else
      (let [after (replacement secret kind strategy canonical (or context {}))]
        (if (= value after)
          {:status :unchanged
           :reason :same-value
           :kind kind
           :before value
           :after after}
          {:status :changed
           :kind kind
           :before value
           :after after})))))

(defn changed? [result]
  (= :changed (:status result)))
